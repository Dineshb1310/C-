#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>



void calculate_the_maximum(int n, int k) {
  int max_and=0;
  int max_or=0;
  int max_xor=0;
  int a,b;
  for(a=1; a<=n; a++){
    for(b=a+1; b<=n; b++){
        int and_res=a&b;
        int or_res=a|b;
        int xor_res=a^b;
    
  
  if(and_res<k && and_res>max_and){
    max_and=and_res;
  }
  if(or_res<k && or_res>max_or){
    max_or=or_res;
  }
  if(xor_res<k && xor_res>max_xor){
    max_xor=xor_res;
  }}
  }
  printf("%d\n",max_and);
  printf("%d\n",max_or);
  printf("%d\n",max_xor);
  
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}
